# Web server (cmd/server)
PORT=6005
DIST_DIR=frontend/dist
RATE_LIMIT_PER_MINUTE=100

# Reverse proxy (optional): comma-separated CIDRs of trusted proxies so
# client IPs are taken from X-Forwarded-For only when the request really
# came through them. Leave unset when exposing the server directly.
# TRUSTED_PROXIES=10.0.0.0/8

# Desktop app only (Wails build) - local database for compound cache/plugins.
# The anonymous web server never opens a database.
DB_DRIVER=sqlite3
DB_DSN=chemistry.db
