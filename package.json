{
  "name": "chemistry-utility",
  "version": "3.0.0",
  "scripts": {
    "start": "cd frontend && npm run dev",
    "dev": "cd frontend && npm run dev",
    "dev:app": "cd frontend && npm run dev:app",
    "dev:host": "cd frontend && npm run dev:host",
    "build": "npm run build:desktop",
    "build:web": "cd frontend && npm run build:web",
    "build:desktop": "npm run stage:desktop && npm --prefix core run build",
    "stage:desktop": "node scripts/stage-dist.mjs",
    "dev:desktop": "npm run stage:desktop && npm --prefix core run dev",
    "clean": "cd frontend && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "cd frontend && npm run test:unit && npm --prefix core run test",
    "test:go": "npm --prefix core run test",
    "test:frontend": "cd frontend && npm run test",
    "test:unit": "cd frontend && npm run test:unit",
    "test:coverage": "cd frontend && npm run test:coverage",
    "test:e2e": "cd frontend && npm run test:e2e",
    "typecheck": "cd frontend && npm run typecheck",
    "lint": "cd frontend && npm run lint && npm --prefix core run lint",
    "lint:fix": "cd frontend && npm run lint:fix",
    "check": "npm run typecheck && npm run lint && npm test",
    "check-bundle-size": "cd frontend && npm run check-bundle-size",
    "cli": "cd frontend && npm run cli",
    "conformance:generate": "cd frontend && npx tsx scripts/generate-conformance.ts",
    "conformance:verify": "npm run conformance:generate && git diff --exit-code conformance/"
  }
}

