{
  "name": "chemistry-utility",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Chemistry calculator website (SolidJS + Vite) with an optional Go desktop wrapper.",
  "overrides": {
    "seroval": "^1.6.3",
    "seroval-plugins": "^1.6.3"
  },
  "scripts": {
    "dev": "vite",
    "dev:app": "vite --mode app",
    "dev:host": "vite --host",
    "build": "npm run build:web",
    "build:web": "vite build --mode web && node scripts/prerender.mjs",
    "build:watch": "vite build --watch",
    "build:web:watch": "vite build --mode web --watch",
    "build:app:watch": "vite build --mode app --watch",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "check": "npm run typecheck && npm run lint && npm run test",
    "check:unit": "npm run typecheck && npm run lint && npm run test:unit",
    "check-bundle-size": "node scripts/check-bundle-size.mjs",
    "cli": "tsx src/cli/index.ts",
    "conformance:generate": "tsx scripts/generate-conformance.ts",
    "conformance:verify": "npm run conformance:generate && git diff --exit-code conformance/",
    "icons:generate": "node scripts/generate-icons.mjs",
    "desktop:stage": "node scripts/stage-dist.mjs",
    "desktop:build": "npm run wails:build",
    "desktop:dev": "npm run wails:dev",
    "wails:doctor": "node scripts/wails.mjs doctor",
    "wails:version": "node scripts/wails.mjs version",
    "wails:dev": "node scripts/wails.mjs dev",
    "wails:build": "node scripts/wails.mjs build",
    "wails:start": "node scripts/wails.mjs start",
    "wails:package": "node scripts/wails.mjs package",
    "core:build": "cd core && go build ./...",
    "core:test": "cd core && go test ./...",
    "core:vet": "cd core && go vet ./...",
    "core:lint": "cd core && golangci-lint run"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "fast-balance": "^1.1.0",
    "gsap": "^3.15.0",
    "katex": "^0.19.0",
    "smiles-drawer": "^2.4.1",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-solid": "^0.18.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.3"
  }
}
