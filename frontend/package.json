{
  "name": "chemistry-utility-frontend",
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:app": "vite --mode app",
    "dev:host": "vite --host",
    "build": "vite build",
    "build:web": "vite build --mode web",
    "build:app": "vite build --mode app",
    "build:watch": "vite build --watch",
    "build:web:watch": "vite build --mode web --watch",
    "build:app:watch": "vite build --mode app --watch",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "check": "npm run typecheck && npm run lint && npm run test",
    "check:unit": "npm run typecheck && npm run lint && npm run test:unit",
    "check-bundle-size": "node scripts/check-bundle-size.mjs",
    "cli": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "fast-balance": "^1.0.7",
    "gsap": "^3.15.0",
    "katex": "^0.19.0",
    "smiles-drawer": "^2.4.1",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/chart.js": "^2.9.41",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-solid": "^0.18.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.3"
  }
}
